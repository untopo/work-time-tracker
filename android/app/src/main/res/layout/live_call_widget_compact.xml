<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/live_call_widget_background"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="6dp">

    <LinearLayout
        android:id="@+id/widget_active_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:background="@drawable/live_call_widget_card"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="8dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/widget_timer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="00:00:00"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/widget_earnings"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="$0.00"
            android:textColor="#7FF5A8"
            android:textSize="13sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/widget_start_btn"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/live_call_widget_primary_icon_button"
            android:padding="9dp"
            android:scaleType="centerInside"
            android:src="@android:drawable/ic_media_play" />

        <ImageView
            android:id="@+id/widget_stop_btn"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/live_call_widget_danger_icon_button"
            android:padding="9dp"
            android:scaleType="centerInside"
            android:src="@android:drawable/ic_media_pause"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/widget_open_btn"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/live_call_widget_secondary_icon_button"
            android:padding="9dp"
            android:scaleType="centerInside"
            android:src="@android:drawable/ic_menu_view" />
    </LinearLayout>
</LinearLayout>
