<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/live_call_widget_background"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:id="@+id/widget_active_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:background="@drawable/live_call_widget_card"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="12dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/widget_timer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="00:00:00"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/widget_earnings"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="$0.00"
            android:textColor="#7FF5A8"
            android:textSize="17sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_start_btn"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@drawable/live_call_widget_primary_button"
        android:gravity="center"
        android:text="Start Call"
        android:textColor="#FFFFFF"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_stop_btn"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@drawable/live_call_widget_danger_button"
        android:gravity="center"
        android:text="Stop Call"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:visibility="gone" />

    <TextView
        android:id="@+id/widget_open_btn"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/live_call_widget_secondary_button"
        android:gravity="center"
        android:text="Open"
        android:textColor="#FFFFFF"
        android:textStyle="bold" />
</LinearLayout>
