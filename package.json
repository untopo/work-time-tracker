{
  "name": "work-time-tracker",
  "version": "1.1.87",
  "description": "Privacy-first time tracker for interpreters and freelancers.",
  "main": "index.js",
  "scripts": {
    "dev:web": "serve . -l 1420 --no-clipboard",
    "build:web": "node scripts/prepare-dist.mjs",
    "android:icons": "powershell -ExecutionPolicy Bypass -File scripts/generate-android-icons.ps1",
    "tauri:dev": "node scripts/tauri-win.mjs dev",
    "tauri:build": "node scripts/tauri-win.mjs build",
    "cap:sync": "npm run build:web && npm run android:icons && npx cap sync",
    "cap:sync:android": "npm run build:web && npm run android:icons && npx cap sync android",
    "cap:open:android": "npx cap open android"
  },
  "keywords": [
    "tracker",
    "time-tracker",
    "interpreters",
    "freelancers",
    "tauri"
  ],
  "author": "Topo",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@tauri-apps/api": "^2.8.0"
  },
  "devDependencies": {
    "@capacitor/android": "^8.1.0",
    "@capacitor/cli": "^8.1.0",
    "@capacitor/core": "^8.1.0",
    "@tauri-apps/cli": "^2.10.0",
    "serve": "^14.2.5"
  }
}



